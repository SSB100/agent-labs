NEXT_PUBLIC_SUPABASE_URL=https://tfdareuwrshjuevuiwvn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_agent_labs_publishable_key

# Server-only. Add directly to Vercel and local .env.local. Never use NEXT_PUBLIC_.
OPENROUTER_API_KEY=replace_with_openrouter_api_key
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=https://agent-labs-two.vercel.app
OPENROUTER_APP_NAME=Agent Labs

# Stage 8 browser provider. Steel is selected by default; Browserbase remains replaceable.
BROWSER_PROVIDER_DEFAULT=steel
STEEL_API_KEY=replace_with_steel_api_key
STEEL_API_BASE_URL=https://api.steel.dev/v1

# Optional alternative adapter.
BROWSERBASE_API_KEY=replace_with_browserbase_api_key
BROWSERBASE_PROJECT_ID=replace_with_browserbase_project_id
BROWSERBASE_API_BASE_URL=https://api.browserbase.com/v1
