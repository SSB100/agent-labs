NEXT_PUBLIC_SUPABASE_URL=https://tfdareuwrshjuevuiwvn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_agent_labs_publishable_key

# Server-only. Add directly to Vercel and local .env.local. Never use NEXT_PUBLIC_.
OPENROUTER_API_KEY=replace_with_openrouter_api_key
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=https://agent-labs-two.vercel.app
OPENROUTER_APP_NAME=Agent Labs

# Stage 8 default browser provider. Server-only.
STEEL_API_KEY=replace_with_steel_api_key
STEEL_API_BASE_URL=https://api.steel.dev
# Optional managed-cloud override. Omit to use Steel's current default region.
# STEEL_REGION=us-east

# Qualified alternative adapter, intentionally inactive while Steel is default.
BROWSERBASE_API_KEY=replace_only_if_browserbase_is_selected
BROWSERBASE_PROJECT_ID=replace_only_if_browserbase_is_selected

# Stage 16. Server-only, separately provisioned. Leave unset until authorized.
# ETSY_KEYSTRING=
# ETSY_SHARED_SECRET=
# ETSY_REDIRECT_URI=https://your-production-domain/api/etsy/callback
# ETSY_VAULT_KEY=64_hex_characters_from_a_secure_random_generator
# ETSY_SERVER_KEY=secure_random_secret_with_matching_private_database_hash

# Core account setup. Server-only; activation requires separate reviewed approval.
# No secret, enabled authority, provider grant or browser budget is installed by migration.
# ACCOUNTS_SERVER_KEY=secure_random_secret_with_matching_private_database_hash
# ACCOUNTS_VAULT_KEY=64_lowercase_hex_characters_from_a_secure_random_generator
# Optional bounded signup browser. All activation gates must be explicitly approved.
# Existing BROWSERBASE_API_KEY and BROWSERBASE_PROJECT_ID stay server-only.
# ACCOUNTS_BROWSERBASE_ENABLED=false
# ACCOUNTS_BROWSERBASE_BUDGET_APPROVED=false
# ACCOUNTS_BROWSERBASE_KEEPALIVE_ENTITLED=false

# Stage 15 durable product executor server authority only. Leave unset until approved.
# This key does NOT enable provider access, source import or physical placement.
# Existing ACCOUNTS_* catalog-read credentials must never be reused for writes.
# PRINTFUL_PRODUCT_SERVER_KEY=separately_provisioned_secret_with_matching_private_hash

# Optional presentation rollback only; existing routes and execution stay unchanged.
# AGENTLABS_GUIDED_UI=legacy
