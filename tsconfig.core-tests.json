    "src/etsy-publication/server.ts",
    "src/accounts/server.ts",
    "src/accounts/etsy-steel-handoff-owner-server.ts",
    "src/accounts/etsy-steel-handoff-server.ts",
    "src/printful/server.ts",
    "src/products/discovery-r12-scope-server.ts",
    "src/products/discovery-r12-owner.ts",
    "src/products/discovery-r12-server.ts",
    "src/products/discovery-r12-server-dependencies.ts",
    "src/products/discovery-r12-preparation-server.ts",
    "src/products/discovery-r12-review-preparation-server.ts",
    "src/products/discovery-r12-pilot-preparation-server.ts",
    "src/creative/focused-owner-server.ts",
    "src/products/discovery-r12-goal-preparation-server.ts",
    "src/products/discovery-r12-adaptive-owner-server.ts",
    "src/products/discovery-r12-adaptive-server.ts",
    "src/products/discovery-r12-owner-observation-server.ts",
    "src/products/discovery-r12-public-owner-server.ts",
