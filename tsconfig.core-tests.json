    "src/browser/types.ts",
    "src/core/**/*.ts",
    "src/connections/contracts.ts",
    "src/connections/etsy-read.ts",
    "src/connections/etsy-refresh.ts",
    "src/connections/printful-read.ts",
    "src/evaluations/**/*.ts",
    "src/lib/core-ui/workflows.ts",
    "src/lib/existing-effect-read-runtime.ts",
    "src/models/**/*.ts",
    "src/packs/**/*.ts",
    "src/research/**/*.ts",
    "src/workers/**/*.ts",
    "src/products/types.ts",
    "src/products/history.ts",
    "src/products/discovery.ts",
    "src/products/discovery-v2.ts",
    "src/products/discovery-v2-knowledge.ts",
    "src/products/discovery-v2-budget.ts",
    "src/products/discovery-v2-research.ts",
    "src/products/discovery-v2-plan.ts",
    "src/products/discovery-v2-worker-contract.ts",
    "src/products/discovery-v2-workers.ts",
    "src/products/discovery-v2-packs.ts",
    "src/products/discovery-v2-runtime.ts",
    "src/products/discovery-v2-goal.ts",
    "src/creative/**/*.ts",
    "src/printful/**/*.ts",
    "src/listing/**/*.ts",
    "src/etsy/contracts.ts",
    "src/etsy/adapter.ts",
    "src/etsy/oauth.ts",
    "src/etsy/vault.ts",
    "src/etsy/engine.ts",
    "src/etsy/packs.ts",
    "src/app/dashboard/printful/preview.ts",
    "src/app/dashboard/printful/pricing-form.ts",
    "src/etsy-publication/**/*.ts",
    "src/accounts/**/*.ts",
    "src/browser/watch/**/*.ts",
    "src/browser/etsy-insights-*.ts",
    "src/browser/etsy-steel-accounting.ts",
    "src/products/discovery-r12-*.ts"
