{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "outDir": ".core-tests",
    "rootDir": "src",
    "noEmit": false,
    "incremental": false
  },
  "include": [
    "src/browser/automation.ts",
    "src/browser/planner/**/*.ts",
