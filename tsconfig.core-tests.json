{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".core-tests",
    "rootDir": "src",
    "noEmit": false,
    "incremental": false
  },
  "include": ["src/core/**/*.ts", "src/models/**/*.ts", "src/workers/**/*.ts"]
}
